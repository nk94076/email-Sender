PORT=3000

# Default SMTP settings (can be overridden from the Settings tab in the UI,
# which stores them in the database instead).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_NAME=Your Name
FROM_EMAIL=your-email@gmail.com

# Delay in milliseconds between each outgoing email, to stay under
# provider rate limits (Gmail ~500/day, ~1 msg/sec recommended).
SEND_DELAY_MS=1000
